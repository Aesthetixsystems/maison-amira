# Replit configuration for the Maison Amira Next.js app.
# The Run button installs deps (in case they're missing) then starts the
# Next.js dev server. The webview maps port 3000 to the public URL.
run = "npm install && npm run dev"
entrypoint = "app/page.tsx"
modules = ["nodejs-20"]

hidden = [".next", "node_modules"]

[env]
NEXT_TELEMETRY_DISABLED = "1"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start"]
