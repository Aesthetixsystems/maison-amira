# Replit configuration for the Maison Amira Next.js app.
# When imported into Replit, "Run" starts the dev server and the
# webview maps port 3000 to the public URL.
run = "npm run dev"
entrypoint = "app/page.tsx"
modules = ["nodejs-20"]

hidden = [".next", "node_modules"]

[env]
NEXT_TELEMETRY_DISABLED = "1"

[nix]
channel = "stable-24_05"

# First run needs deps installed:  npm install
[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80
