# Maison Amira — environment variables
# Copy this file to .env.local (never commit .env.local) and fill in real values.
# In Replit: add these under the "Secrets" (padlock) panel instead of a file.
# In Vercel: add them under Project → Settings → Environment Variables.

# ── Stripe (payments) ──────────────────────────────────────────
# From dashboard.stripe.com/apikeys  (use TEST keys until you go live)
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook you create at dashboard.stripe.com/webhooks
# (endpoint: https://YOUR-DOMAIN/api/webhooks/stripe, event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Supabase (order storage) ───────────────────────────────────
# From your Supabase project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# The SERVICE ROLE key (server-only secret — keep it private)
SUPABASE_SERVICE_ROLE_KEY=xxx

# ── Site ───────────────────────────────────────────────────────
# Your live URL (used for Stripe success/return links). Optional in dev.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
